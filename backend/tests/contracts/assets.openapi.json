      "post": {
        "description": "Register an unverified lab asset; never contact it or authorize scanning.\n\nIdempotency-Key is scoped to actor/tenant/method/route for 24 hours. Replay\nreturns the original response (not current state); use GET to refresh it.\nCurrent session, permission, CSRF and policy are checked before replay.",
        "operationId": "create_asset_api_v1_assets_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$",
              "title": "Idempotency-Key",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "title": "X-Csrf-Token",
              "type": "string"
            }
          }
        ],
        "requestBody": {
