APP_NAME=SentinelAI Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
# Example values for running the backend directly from this directory.
# Root Compose overrides DATABASE_URL with its internal PostgreSQL service and
# obtains infrastructure credentials from the root .env file.
CORS_ORIGINS=http://localhost:8083,http://127.0.0.1:8083
TRUSTED_ORIGINS=http://localhost:8083,http://127.0.0.1:8083
CSRF_HEADER_NAME=X-CSRF-Token
SESSION_ABSOLUTE_MINUTES=720
SESSION_IDLE_MINUTES=30
DATABASE_URL=postgresql+psycopg://sentinelai_runtime:local-example-only@localhost:5432/sentinelai_local
