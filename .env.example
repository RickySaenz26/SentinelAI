# Copy to .env for Docker Compose. These values are for local development only.
# Never use them in production. Generate unique production credentials with, for
# example: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))

# Frontend host binding; Caddy serves the SPA and proxies /api to the backend.
FRONTEND_PORT=8083

# Backend configuration. Caddy proxies /api internally; the backend has no host port.
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8083,http://127.0.0.1:8083
TRUSTED_ORIGINS=http://localhost:8083,http://127.0.0.1:8083
CSRF_HEADER_NAME=X-CSRF-Token

# Sprint 2A inventory only. Empty means deny all targets; never a scan permit.
LAB_ASSET_POLICY_JSON=

# Increment 2 stage 1: internal library only; no provisioning or activation here.
# Absolute Linux directories outside checkout; values contain NO key material.
LAB_EVIDENCE_ROOT=
LAB_EVIDENCE_KEY_ROOT=
LAB_EVIDENCE_ACTIVE_KEY_ID=

# Infrastructure credentials: deliberately local placeholders, unsuitable for production.
POSTGRES_DB=sentinelai_local
POSTGRES_USER=sentinelai_migrator
POSTGRES_PASSWORD=local-development-only-replace-before-production
POSTGRES_RUNTIME_USER=sentinelai_runtime
POSTGRES_RUNTIME_PASSWORD=local-development-only-replace-before-production
REDIS_PASSWORD=local-development-only-replace-before-production
